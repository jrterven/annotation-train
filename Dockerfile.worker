# Verified on ARM64 GB10. This vendor image supplies its matching CUDA PyTorch
# and torchvision builds; never replace them with CPU or mismatched wheels.
FROM nvcr.io/nvidia/pytorch:25.10-py3@sha256:42263b2424fc237b34c4fc4a91c30d603c57eed36e37d31ff6d9a4f1f801edee
USER root
WORKDIR /annotation
COPY requirements-worker.txt ./
# These unused vendor-image extras have incompatible NumPy/optional dependency
# constraints. Removing them leaves the CUDA framework and drivers unchanged.
RUN python -m pip install --no-cache-dir -r requirements-worker.txt \
    && python -m pip uninstall -y numba librosa nvidia-resiliency-ext \
    && python -m pip check
COPY app/ ./app/
COPY deploy/probe_worker.py ./deploy/probe_worker.py
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/annotation
ENTRYPOINT []
CMD ["python", "-m", "app.hosted.worker"]
