# Copy outside the checkout, chmod 600, and fill separately for dev and prod.
# The bucket, Google project and OAuth secret must match the environment.
ANNOTATION_ENVIRONMENT=dev
ANNOTATION_PUBLIC_URL=http://localhost:8765
ANNOTATION_DATABASE_URL=postgresql+psycopg://annotation:REPLACE@postgres:5432/annotation
ANNOTATION_GOOGLE_CLIENT_ID=REPLACE
ANNOTATION_GOOGLE_CLIENT_SECRET=REPLACE
ANNOTATION_R2_ENDPOINT_URL=https://REPLACE.r2.cloudflarestorage.com
ANNOTATION_R2_BUCKET=annotation-dev
ANNOTATION_R2_ACCESS_KEY_ID=REPLACE
ANNOTATION_R2_SECRET_ACCESS_KEY=REPLACE
ANNOTATION_PRIMARY_WORKER_URL=http://REPLACE_PRIVATE_TAILSCALE_ADDRESS:8766
ANNOTATION_PRIMARY_WORKER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Enable the dedicated fallback host only after its real smoke tests pass.
ANNOTATION_FALLBACK_WORKER_URL=
ANNOTATION_FALLBACK_WORKER_TOKEN=
