# Replace the hostname and certificate paths in private deployment config.
# Add only after the application, Google OAuth and GPU readiness tests pass.
server {
    listen 443 ssl;
    server_name annotation.example.com;
    ssl_certificate /etc/ssl/private/REPLACE-fullchain.pem;
    ssl_certificate_key /etc/ssl/private/REPLACE-key.pem;
    client_max_body_size 64m;
    # OAuth callback query strings contain one-time credentials. This server
    # intentionally does not inherit the default request-URI access logger.
    access_log off;
    add_header X-Content-Type-Options nosniff always;
    proxy_hide_header X-Content-Type-Options;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        proxy_request_buffering off;
    }
}
