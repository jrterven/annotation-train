ANNOTATION_WORKER_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ANNOTATION_WORKER_DATA_DIR=/var/lib/annotation-worker
ANNOTATION_WORKER_BIND=REPLACE_PRIVATE_TAILSCALE_ADDRESS
# Exact source IPs, comma-separated; only the CPU server is authorized remotely.
# Loopback probes are always allowed. Forwarded headers must remain disabled.
ANNOTATION_WORKER_ALLOWED_CLIENTS=REPLACE_CPU_SERVER_TAILSCALE_ADDRESS
SAM3_DEVICE=cuda
# Select by the GPU UUID stored only in the private deployment configuration.
CUDA_VISIBLE_DEVICES=REPLACE_PRIVATE_GPU_UUID
HF_HUB_CACHE=/var/cache/annotation-models
HF_HUB_DISABLE_PROGRESS_BARS=1
# Provision authorized model weights in the cache or provide a private HF token.
HF_TOKEN=
SAM3_REVISION=3c879f39826c281e95690f02c7821c4de09afae7
