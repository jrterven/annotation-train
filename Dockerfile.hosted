FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
# pg_dump is used by the coordinated backup CLI. Use the same major as Postgres.
RUN apt-get update && apt-get install -y --no-install-recommends postgresql-client-15 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home annotation
COPY requirements-hosted.txt ./
RUN python -m pip install --no-cache-dir -r requirements-hosted.txt
COPY app/ ./app/
COPY run_hosted.py ./
COPY --from=frontend /build/dist/ ./frontend/dist/
RUN mkdir -p /var/lib/annotation /var/cache/annotation \
    && chown -R annotation:annotation /var/lib/annotation /var/cache/annotation
USER annotation
EXPOSE 8765
CMD ["python", "run_hosted.py", "--host", "0.0.0.0"]
